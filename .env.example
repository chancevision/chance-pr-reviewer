# LLM Provider (OpenAI-compatible: OpenRouter, DeepSeek, Groq, etc.)
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=sk-or-v1-xxx
LLM_MODEL=deepseek/deepseek-v4-pro

# Enable reasoning/thinking mode for higher review quality (optional)
# When enabled, uses reasoning_effort=high instead of fixed temperature
LLM_ENABLE_THINKING=false

# GitHub App
GITHUB_APP_ID=123456
GITHUB_APP_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"
GITHUB_WEBHOOK_SECRET=whsec_xxx

# Server
PORT=3000
